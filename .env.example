# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
# Nginx kabi reverse-proxy ortida ishlasa: true
TRUST_PROXY=false

# Kamida 32 belgili tasodifiy satr. `npm run init` avtomatik yaratadi.
APP_SECRET=
# Sessiya muddati (soat). Standart: 7 kun
SESSION_TTL_HOURS=168

# ─── MySQL ────────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shaxsiy_vault
# Ilova shu foydalanuvchi bilan ulanadi (faqat DB_NAME bazasiga huquqi bo'ladi)
DB_USER=vault_app
DB_PASSWORD=

# Faqat `npm run db:setup` uchun: baza va DB_USER ni yaratish huquqiga ega admin (odatda root).
# Sozlashdan keyin bu ikki qatorni o'chirib tashlash tavsiya etiladi.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=

# ─── AI maslahatchi (ixtiyoriy) ───────────────────────────
# https://platform.claude.com dan olingan API kalit. Bo'sh qolsa, AI funksiyasi o'chiq bo'ladi.
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5

# ─── Admin panel ──────────────────────────────────────────
# Ilovada shu email(lar) bilan ro'yxatdan o'tgan hisob admin bo'ladi. Bir nechtasini vergul bilan yozing.
# O'zgartirgandan keyin serverni qayta ishga tushiring.
ADMIN_EMAILS=
